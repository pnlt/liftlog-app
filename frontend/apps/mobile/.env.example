# Clerk: dashboard -> API keys. Required.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# FastAPI origin, without /api/v1. Android emulator: http://10.0.2.2:8000
# For a physical device use the development computer's LAN address.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Sanity content source. Leave empty to use the bundled exercise catalog.
EXPO_PUBLIC_SANITY_PROJECT_ID=
EXPO_PUBLIC_SANITY_DATASET=production
